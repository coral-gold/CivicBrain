NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/civicbrain   # or "memory" for a built-in dev database
JWT_SECRET=            # openssl rand -base64 48
OTP_PEPPER=            # openssl rand -base64 48
COOKIE_NAME=cb_session
OTP_DEV_LOG=true       # prints OTP in server console; MUST be false in production
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CivicBrain <verified-sender@yourdomain.com>"
ADMIN_SEED_EMAIL=admin@civicbrain.local
ADMIN_SEED_PASSWORD=Change.Me.Str0ng!
