# --- backend (Spring Boot) --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/civicbrain
DB_USER=civic
DB_PASSWORD=civic
# >= 32 bytes each. Generate with: openssl rand -base64 48
JWT_SECRET=
OTP_HMAC_SECRET=
MEDIA_SIGNING_SECRET=
COOKIE_SECURE=false        # true in production (HTTPS)
TRUST_PROXY=false          # true only behind your own reverse proxy (honours X-Forwarded-For)
WARD_COUNT=30              # fallback until ward boundaries are uploaded
SMTP_HOST=localhost        # Mailpit in dev; Brevo in prod
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@civicbrain.local
# First SUPER_ADMIN (created once, if absent). Password policy: >=12 chars, upper, lower, digit, symbol.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
STORAGE_DIR=./uploads
# --- frontend (Next.js) – put these in frontend/.env.local ------------------------------
# BACKEND_URL=http://localhost:8080
# JWT_SECRET=<same value as the backend>
